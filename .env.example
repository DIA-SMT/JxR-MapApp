# JxR MapApp — entorno local (copiar a .env.local y completar; NO commitear)

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: NUNCA exponer al cliente ni commitear
SUPABASE_SERVICE_ROLE_KEY=

# Migue (asistente IA) — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Estilo del mapa base (opcional; por defecto Carto dark-matter)
NEXT_PUBLIC_MAP_STYLE_DARK=
